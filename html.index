    <!-- FOOTER SECTION -->
    <footer>
        <p><strong>𝐍𝐚𝐤𝐡𝐫𝐚 𝐚𝐧𝐝 𝐂𝐨.</strong></p>
        <p style="margin-top: 5px; font-size: 0.9rem;">Follow us on Instagram for latest collections!</p>
        <a href="https://instagram.com/nakhraandco.pk" class="social-link" target="_blank">📸 @nakhraandco.pk</a>
        <p style="margin-top: 20px; font-size: 0.8rem; color: #777;">© 2026 Nakhra and Co. Website Designed by Web Solutions.</p>
    </footer>

    <!-- HAMBURGER MENU JAVASCRIPT -->
    <script>
        function toggleMenu() {
            var menu = document.getElementById("mobileMenu");
            menu.classList.toggle("active");
        }
    </script>

</body>
</html>
