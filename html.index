        </div>

        <nav class="nav-links" id="mobileMenu">
            <a href="#home-section" onclick="toggleMenu()">🏠 Home & Bedding</a>
            <a href="#makeup-section" onclick="toggleMenu()">💄 Makeup</a>
            <a href="#clothing-section" onclick="toggleMenu()">👗 Women's Clothes</a>
            <a href="https://instagram.com/nakhraandco.pk" target="_blank">📸 Instagram</a>
